{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "importHelpers": true,
    "removeComments": true,
    "noLib": false,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es6",
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./lib",
    "lib": ["es2022", "DOM"],
    // Compile against the @types layout so the emitted .d.ts stays compatible
    // with every nodemailer major allowed by peerDependencies (>=8).
    "paths": {
      "nodemailer": ["./node_modules/@types/nodemailer"],
      "nodemailer/*": ["./node_modules/@types/nodemailer/*"]
    }
  },
  "include": ["lib/**/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
