{
  "name": "@nestjs-modules/mailer",
  "version": "4.0.0",
  "private": false,
  "description": "NestJS - a mailer module (@mailer)",
  "keywords": [
    "nest",
    "nodemailer",
    "mailer",
    "nodejs",
    "email",
    "nestjs-mail",
    "smtp",
    "handlebars",
    "mjml"
  ],
  "homepage": "https://github.com/nest-modules/mailer#readme",
  "bugs": {
    "url": "https://github.com/nest-modules/mailer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-modules/mailer.git"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs-mail": {
      "types": "./dist/nestjs-mail/index.d.ts",
      "default": "./dist/nestjs-mail/index.js"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.ts",
      "default": "./dist/outbox/index.js"
    },
    "./adapters/*.js": {
      "types": "./dist/adapters/*.d.ts",
      "default": "./dist/adapters/*.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "default": "./dist/adapters/*.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "nestjs-mail": [
        "./dist/nestjs-mail/index.d.ts"
      ],
      "outbox": [
        "./dist/outbox/index.d.ts"
      ],
      "adapters/*": [
        "./dist/adapters/*"
      ],
      "dist/*": [
        "./dist/*"
      ]
    }
  },
  "author": "Nest Modules TM",
  "contributors": [
    "Cristiam D\u00edaz <c.diaz@udla.edu.co>",
    "Eduardo Leal <eduardolleal@icloud.com>",
    "Juan Echeverry <e.juandav@gmail.com>",
    "Pawe\u0142 Partyka <partyka95@icloud.com>",
    "Alexandre TITEUX <alexandretiteux@gmail.com>",
    "Yanarp",
    "Joao vitor FREZYN <00001097715413SP@al.educacao.sp.gov.br>"
  ],
  "scripts": {
    "prebuild": "rimraf dist && cp ../../README.md .",
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js && node --test test/nestjs-mail.interop.test.mjs test/outbox.interop.test.mjs",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:interop": "node --test test/nestjs-mail.interop.test.mjs test/outbox.interop.test.mjs"
  },
  "dependencies": {
    "@css-inline/css-inline": "0.23.1",
    "glob": "13.0.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/mail": "0.0.1",
    "@nestjs/outbox": "0.1.3",
    "@nestjs/testing": "12.2.0",
    "@types/ejs": "3.1.5",
    "@types/jest": "30.0.0",
    "@types/mjml": "5.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pug": "2.0.10",
    "ejs": "7.0.2",
    "handlebars": "4.7.10",
    "jest": "30.5.2",
    "liquidjs": "10.30.0",
    "mjml": "5.4.1",
    "nodemailer": "10.2.1",
    "nodemailer-mock": "2.2.0",
    "nunjucks": "3.2.4",
    "preview-email": "3.4.1",
    "pug": "3.0.4",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=7.0.9",
    "@nestjs/core": ">=7.0.9",
    "@nestjs/event-emitter": ">=2.0.0",
    "@nestjs/mail": ">=0.0.1",
    "@nestjs/outbox": ">=0.1.3",
    "@nestjs/terminus": ">=10.0.0",
    "@types/ejs": ">=3.0.3",
    "@types/mjml": ">=4.7.4",
    "@types/pug": ">=2.0.6",
    "bullmq": ">=4.0.0",
    "ejs": ">=3.1.10",
    "handlebars": ">=4.7.10",
    "liquidjs": ">=10.25.5",
    "mjml": ">=4.15.3",
    "nodemailer": ">=8.0.5",
    "nunjucks": ">=3.2.0",
    "preview-email": ">=3.0.19",
    "pug": ">=3.0.3"
  },
